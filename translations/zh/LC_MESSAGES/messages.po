msgstr "此链接包含客户端访问凭据，将在一分钟后隐藏。设置来自管理器文件，可能与正在运行的服务不同。"


msgid "Экспорт этого протокола ещё не перенесён"
msgstr "此协议的导出功能尚未迁移"


msgid "Список клиентов загружен без секретов"
msgstr "已加载客户端列表，不含密钥"


msgid "Конфигурации протоколов"
msgstr "协议配置"


msgid "Прочитать конфигурации"
msgstr "读取配置"


msgid "Проверка ищет файлы настроек TelegramOnly на хосте и в bind mounts бота, включая остановленные контейнеры. Пароли, ключи и клиентские ссылки не отображаются. Наличие файла не подтверждает применение настроек к службе."
msgstr "在主机和机器人绑定挂载中查找 TelegramOnly 设置，包括已停止的容器。不显示密码、密钥和客户端链接。存在设置文件并不表示这些设置已应用于服务。"


msgid "Возможный файл настроек; владелец не подтверждён"
msgstr "可能的设置文件；归属尚未确认"


msgid "TelegramOnly / systemd"
msgstr "TelegramOnly / systemd"


msgid "TelegramOnly / Docker"
msgstr "TelegramOnly / Docker"


msgid "Найдено несколько конфигураций"
msgstr "发现多个配置"


msgid "Файлы менеджера не найдены"
msgstr "未找到管理器配置文件"


msgid "Обнаружена 3x-ui: требуется проверка владельца VLESS"
msgstr "检测到 3x-ui：需要确认 VLESS 的管理归属"


msgid "Включён в менеджере"
msgstr "在管理器中已启用"


msgid "Проверка TLS отключена"
msgstr "已禁用 TLS 验证"


msgid "Транспорт"
msgstr "传输方式"


msgid "Режим"
msgstr "模式"


msgid "Защита"
msgstr "安全方式"


msgid "Файл недоступен или имеет неподдерживаемый формат"
msgstr "文件无法访问或格式不受支持"


msgid "Количество клиентов"
msgstr "客户端数量"


msgid "Конфигурации прочитаны без изменений"
msgstr "已读取配置，未进行更改"


msgid "Данные из «Статуса»"
msgstr "来自“状态”的数据"


msgid "Данные мониторинга"
msgstr "监控数据"


msgid "Загружаю данные мониторинга…"
msgstr "正在加载监控数据…"


msgid "Данные получены из мониторинга. Для управления выполните проверку по SSH."
msgstr "已从监控加载数据。请运行 SSH 检查以管理服务。"


msgid "Мониторинг недоступен. Можно выполнить отдельную проверку по SSH."
msgstr "监控不可用。您可以单独运行 SSH 检查。"


msgid "Управление сервером"
msgstr "服务器管理"


msgid "Не удалось выполнить операцию. Проверьте SSH, known_hosts и root/sudo -n. После потери ответа обновите состояние перед повтором."
msgstr "无法完成操作。请检查 SSH、known_hosts 和 root/sudo -n。若响应丢失，请刷新状态后再重试。"


msgid "Выберите службу и действие"
msgstr "请选择服务和操作"


msgid "Цель изменилась. Обновите состояние и создайте новый план."
msgstr "目标已更改。请刷新状态并创建新计划。"


msgid "Сначала создайте план"
msgstr "请先创建计划"


msgid "Операция не подтверждена. Обновите состояние: служба могла измениться или команда завершилась с ошибкой."
msgstr "操作尚未确认。请刷新状态：服务可能已更改或命令执行失败。"


msgid "Проверить по SSH"
msgstr "通过 SSH 检查"


msgid "Управление использует SSH из карточки. Бот не обязателен. Способ запуска определяется отдельно для каждой службы."
msgstr "使用此服务器卡片中保存的 SSH 信息进行管理，无需机器人。每项服务的运行方式分别检测。"


msgid "Подключение требует известного ключа в known_hosts и прав root или sudo -n."
msgstr "连接需要 known_hosts 中的可信主机密钥以及 root 或 sudo -n 权限。"


msgid "Перенос в разработке: доступны обнаружение и запуск, остановка, перезапуск служб. Настройки протоколов, клиенты и установщики пока не перенесены."
msgstr "迁移开发中：现已支持服务检测、启动、停止和重启。协议设置、客户端和安装程序尚未迁移。"


msgid "План изменения"
msgstr "变更计划"


msgid "Остановка или перезапуск может прервать активные подключения. Проверьте выбранную службу и введите имя VPS из плана."
msgstr "停止或重启可能中断现有连接。请检查所选服务并输入计划中显示的 VPS 主机名。"


msgid "Имя VPS"
msgstr "VPS 主机名"


msgid "Применить план"
msgstr "应用计划"


msgid "Запустить"
msgstr "启动"


msgid "Остановить"
msgstr "停止"


msgid "Перезапустить"
msgstr "重启"


msgid "Работает"
msgstr "运行中"


msgid "Остановлена"
msgstr "已停止"


msgid "Создана"
msgstr "已创建"


msgid "Выполняется…"
msgstr "正在执行…"


msgid "Не обнаружено в доступных средах"
msgstr "在可访问的运行环境中未检测到"


msgid "План готов. Срок действия — 5 минут."
msgstr "计划已就绪，有效期为 5 分钟。"


msgid "Состояние обновлено"
msgstr "状态已刷新"


msgid "Операция выполнена"
msgstr "操作已完成"


msgid "Текущий файл данных не расшифровывается ключом из .env этой установки. Восстановите прежний SECRET_KEY в .env и перезапустите приложение."
msgstr "当前数据文件无法用本安装 .env 中的密钥解密。请在 .env 中恢复原来的 SECRET_KEY 并重启应用。"

#: app/routes/dns.py templates/dns
msgid "Серверы с паролями и карточка DNS (провайдеры, домены, записи) хранятся в одном зашифрованном файле .enc. Открыть его можно только ключом SECRET_KEY, поэтому резервная копия — это всегда файл данных плюс ключ."
msgstr "服务器及其密码和 DNS 卡片（服务商、域名、记录）保存在同一个加密的 .enc 文件中。只有 SECRET_KEY 能打开它，因此备份始终是数据文件加密钥。"

#: app/routes/dns.py templates/dns
msgid "Полный экспорт (рекомендуется):"
msgstr "完整导出（推荐）："

#: app/routes/dns.py templates/dns
msgid "ZIP-архив в папке «Загрузки»: файл данных со всеми серверами и DNS, ключ SECRET_KEY.env, PIN.txt и иконки серверов. Это и есть резервная копия."
msgstr "“下载”文件夹中的 ZIP 压缩包：包含所有服务器和 DNS 的数据文件、SECRET_KEY.env 密钥、PIN.txt 和服务器图标。这就是您的备份。"

#: app/routes/dns.py templates/dns
msgid "Только файл .enc (серверы и DNS) без ключа — для копии туда, где уже стоит тот же ключ."
msgstr "仅 .enc 文件（服务器和 DNS），不含密钥——用于复制到已安装相同密钥的位置。"

#: app/routes/dns.py templates/dns
msgid "В архиве полного экспорта вместе лежат данные, ключ и PIN: любой, у кого он окажется, увидит все пароли. Храните его в менеджере паролей или на зашифрованном диске."
msgstr "完整导出压缩包同时包含数据、密钥和 PIN：任何拿到它的人都能看到所有密码。请将其保存在密码管理器或加密磁盘中。"

#: app/routes/dns.py templates/dns
msgid "Восстановление из полного экспорта"
msgstr "从完整导出恢复"

#: app/routes/dns.py templates/dns
msgid "Новая установка или полная замена данных:"
msgstr "新安装或完全替换数据："

#: app/routes/dns.py templates/dns
msgid "Закройте приложение."
msgstr "关闭应用。"

#: app/routes/dns.py templates/dns
msgid "Скопируйте SECRET_KEY.env из архива в папку данных приложения и переименуйте в .env."
msgstr "将压缩包中的 SECRET_KEY.env 复制到应用数据文件夹并重命名为 .env。"

#: app/routes/dns.py templates/dns
msgid "Скопируйте иконки из папки uploads архива в папку uploads приложения."
msgstr "将压缩包 uploads 文件夹中的图标复制到应用的 uploads 文件夹。"

#: app/routes/dns.py templates/dns
msgid "Запустите приложение и войдите по PIN этого компьютера. PIN хранится в настройках установки и из архива не переносится; PIN.txt — напоминание о прежнем PIN."
msgstr "启动应用并使用本机的 PIN 登录。PIN 按安装分别保存，不会从压缩包恢复；PIN.txt 只是旧 PIN 的提醒。"

#: app/routes/dns.py templates/dns
msgid "«Настройки» → «Импорт файла данных» → выберите файл .enc из архива → «Импортировать и прикрепить»."
msgstr "“设置” → “导入数据文件” → 选择压缩包中的 .enc 文件 → “导入并附加”。"

#: app/routes/dns.py templates/dns
msgid "На компьютере уже есть свои серверы — объединить:"
msgstr "计算机上已有自己的服务器——合并："

#: app/routes/dns.py templates/dns
msgid "Файл .env не меняйте."
msgstr "不要修改 .env 文件。"

#: app/routes/dns.py templates/dns
msgid "«Настройки» → «Импорт серверов из другой установки» → файл .enc из архива."
msgstr "“设置” → “从其他安装导入服务器” → 压缩包中的 .enc 文件。"

#: app/routes/dns.py templates/dns
msgid "Вставьте ключ — значение из SECRET_KEY.env после «SECRET_KEY=»."
msgstr "粘贴密钥：SECRET_KEY.env 中“SECRET_KEY=”之后的值。"

#: app/routes/dns.py templates/dns
msgid "Нажмите «Импортировать и объединить сервера»."
msgstr "点击“导入并合并服务器”。"


#: app/routes/dns.py templates/dns
msgid "Добавляет домены и DNS-провайдеров, которых у вас ещё нет; уже имеющиеся домены не меняются"
msgstr "添加您尚未拥有的域名和 DNS 服务商；已有域名不会更改"

#: app/routes/dns.py templates/dns
msgid "Импорт добавляет серверы к вашим: дубликаты (то же имя или IP) пропускаются, текущие серверы не удаляются"
msgstr "导入会将服务器添加到您的列表：重复项（名称或 IP 相同）会被跳过，现有服务器保留"

#: app/routes/dns.py templates/dns
msgid "Создаётся новый файл данных; прежний остаётся в папке data"
msgstr "会创建新的数据文件；原文件保留在 data 文件夹中"

#: app/routes/dns.py templates/dns
msgid "Восстановить из архива:"
msgstr "从压缩包恢复："

#: app/routes/dns.py templates/dns
msgid "Создайте PIN, затем восстановите данные из полного экспорта по инструкции в разделе «Импорт и Экспорт». Кнопка «Импортировать из архива» на экране входа пока не работает."
msgstr "先创建 PIN，然后按照“导入和导出”部分的说明从完整导出恢复数据。登录界面上的“从压缩包导入”按钮目前无法使用。"

#: app/routes/dns.py templates/dns
msgid "Восстановление:"
msgstr "恢复："

#: app/routes/dns.py templates/dns
msgid "PIN хранится в каждой установке отдельно: PIN.txt — лишь напоминание, при восстановлении он не применяется. Чтобы оставить прежний PIN, задайте его в настройках"
msgstr "PIN 按安装分别保存：PIN.txt 只是提醒，恢复时不会应用。如需保留旧 PIN，请在设置中重新设置"

#: templates/help.html
msgid "Папка данных приложения:"
msgstr "应用数据文件夹："

msgid "Возможности и подключение"
msgstr "功能和连接"

msgid "Доступны управление службами, чтение конфигураций и экспорт поддерживаемых профилей. Установка, изменение настроек и создание клиентов ещё разрабатываются."
msgstr "可管理服务、查看配置和导出支持的配置文件。安装、修改设置和创建客户端仍在开发中。"

msgid "Поиск службы"
msgstr "搜索服务"

msgid "Показать службы"
msgstr "显示服务"

msgid "Обнаруженные"
msgstr "已发现"

msgid "Все службы"
msgstr "所有服务"

msgid "Работающие"
msgstr "运行中"

msgid "Остановленные и ошибки"
msgstr "已停止和故障"

msgid "Нет служб по выбранному фильтру. Выберите «Все службы» или выполните проверку по SSH."
msgstr "没有符合筛选条件的服务。请选择所有服务或通过 SSH 检查。"

msgid "Конфигурации протоколов и клиенты"
msgstr "协议配置和客户端"


msgid "Сначала остановите TelegramOnly: одновременное изменение настроек ботом не поддерживается."
msgstr "请先停止 TelegramOnly：不支持与机器人同时修改配置。"

msgid "Настройки менеджера отличаются от файла службы. Изменения заблокированы."
msgstr "管理器设置与服务配置不同，已阻止修改。"

msgid "Изменение доступно для одной работающей службы AnyTLS systemd с выделенным конфигом sing-box."
msgstr "修改要求只有一个运行中的 AnyTLS systemd 服务，并使用独立的 sing-box 配置。"

msgid "Этот формат конфигурации пока доступен только для чтения."
msgstr "此配置格式目前只支持读取。"

msgid "Найдено несколько файлов настроек. Изменения заблокированы."
msgstr "发现多个配置文件，已阻止修改。"

msgid "Клиент с таким именем уже существует."
msgstr "同名客户端已存在。"

msgid "Клиент больше не существует. Прочитайте настройки заново."
msgstr "客户端已不存在，请重新读取配置。"

msgid "Нельзя удалить последнего клиента."
msgstr "不能删除最后一个客户端。"

msgid "Проверка sing-box не прошла. Рабочие файлы не изменены."
msgstr "sing-box 验证失败，运行配置文件未被修改。"

msgid "Изменение не применилось. Предыдущие файлы восстановлены, служба работает."
msgstr "修改失败，已恢复原文件，服务正在运行。"

msgid "Требуется восстановление по SSH. Резервная копия сохранена; новые изменения заблокированы."
msgstr "需要通过 SSH 恢复。备份已保存，后续修改已被阻止。"

msgid "Права или расположение файлов не позволяют безопасно изменить конфигурацию."
msgstr "文件权限或位置不允许安全修改配置。"

msgid "Неверные параметры изменения"
msgstr "修改参数无效"

msgid "Для AnyTLS systemd доступны смена порта и управление клиентами с резервной копией и откатом. Остальные протоколы пока доступны для чтения и управления службами. Автономная установка ещё разрабатывается."
msgstr "AnyTLS systemd 支持修改端口和管理客户端，并提供备份与回滚。其他协议支持查看配置和服务管理。独立安装功能仍在开发中。"

msgid "Резервная копия"
msgstr "备份"

msgid "Изменить порт"
msgstr "修改端口"

msgid "Создать клиента"
msgstr "创建客户端"

msgid "Отозвать клиента"
msgstr "撤销客户端"

msgid "Будут сохранены резервные копии обоих файлов, проверен конфиг и перезапущена служба. При ошибке будет выполнен откат."
msgstr "将备份两个文件、验证配置并重启服务。失败时执行回滚。"

msgid "Изменение требует одной работающей службы AnyTLS systemd и остановленного бота. Совпадение настроек с рабочим конфигом проверяется перед применением."
msgstr "修改要求只有一个运行中的 AnyTLS systemd 服务，且机器人已停止。应用前会核对设置与运行配置是否一致。"

msgid "Новый порт AnyTLS"
msgstr "新的 AnyTLS 端口"

msgid "Имя клиента: латиница, цифры, точка, дефис"
msgstr "客户端名称：拉丁字母、数字、点、连字符"

msgid "Имя нового клиента"
msgstr "新客户端名称"


msgid "Неизвестно"
msgstr "未知"


msgid "Изменение доступно для одной работающей службы systemd с выделенным конфигом sing-box."
msgstr "修改要求只有一个运行中的 systemd 服务，并使用独立的 sing-box 配置。"

msgid "Для AnyTLS, TUIC и XHTTP systemd доступны смена порта и управление клиентами с резервной копией и откатом. Остальные протоколы пока доступны для чтения и управления службами. Автономная установка ещё разрабатывается."
msgstr "AnyTLS、TUIC 和 XHTTP systemd 支持修改端口和管理客户端，并提供备份与回滚。其他协议支持查看配置和服务管理。独立安装功能仍在开发中。"

msgid "Изменение требует одной работающей службы systemd и остановленного бота. Совпадение настроек с рабочим конфигом проверяется перед применением."
msgstr "修改要求只有一个运行中的 systemd 服务，且机器人已停止。应用前会核对设置与运行配置是否一致。"

msgid "Новый порт"
msgstr "新端口"


msgid "Клиент default защищён: TelegramOnly может восстановить его из основного UUID."
msgstr "default 客户端受到保护：TelegramOnly 可能根据主 UUID 恢复它。"

msgid "Обнаружена 3x-ui. Изменяйте VLESS через панель владельца конфигурации."
msgstr "检测到 3x-ui。请通过管理此配置的面板修改 VLESS。"

msgid "Изменение доступно для одной работающей службы systemd с выделенным конфигом sing-box или Xray."
msgstr "修改要求只有一个运行中的 systemd 服务，并使用独立的 sing-box 或 Xray 配置。"

msgid "Проверка конфигурации службой не прошла. Рабочие файлы не изменены."
msgstr "服务配置验证失败，运行配置文件未被修改。"

msgid "Для AnyTLS, TUIC, XHTTP и VLESS/Reality systemd доступны смена порта и управление клиентами с резервной копией и откатом. Остальные протоколы пока доступны для чтения и управления службами. Автономная установка ещё разрабатывается."
msgstr "AnyTLS、TUIC、XHTTP 和 VLESS/Reality systemd 支持修改端口和管理客户端，并提供备份与回滚。其他协议支持查看配置和服务管理。独立安装功能仍在开发中。"


msgid "Общий пароль Hysteria2: доступна только смена порта. Переход на отдельных клиентов требует отдельной настройки."
msgstr "Hysteria2 使用共享密码：仅支持修改端口。切换到独立客户端需要单独配置。"

msgid "Hysteria2: проверяется структура конфигурации. Нативной проверки без запуска нет; ошибка запуска приведёт к откату. Имена клиентов: строчные латинские буквы, цифры, дефис и подчёркивание."
msgstr "Hysteria2：检查配置结构。没有无需启动的原生检查；启动失败将触发回滚。客户端名称可包含小写拉丁字母、数字、连字符和下划线。"

msgid "Изменение доступно для одной работающей службы systemd с выделенным конфигом sing-box, Xray или Hysteria2."
msgstr "修改要求只有一个运行中的 systemd 服务，并使用独立的 sing-box、Xray 或 Hysteria2 配置。"

msgid "Для AnyTLS, TUIC, XHTTP, VLESS/Reality и Hysteria2 systemd доступны смена порта и управление клиентами с резервной копией и откатом. Остальные протоколы пока доступны для чтения и управления службами. Автономная установка ещё разрабатывается."
msgstr "AnyTLS、TUIC、XHTTP、VLESS/Reality 和 Hysteria2 systemd 支持修改端口和管理客户端，并提供备份与回滚。其他协议支持查看配置和服务管理。独立安装功能仍在开发中。"


msgid "Клиент default защищён: TelegramOnly может восстановить его из основного UUID или пароля."
msgstr "default 客户端受到保护：TelegramOnly 可能根据主 UUID 或密码恢复它。"

msgid "Общий пароль NaiveProxy: доступна только смена порта."
msgstr "NaiveProxy 使用一个共享账户：仅支持修改端口。"

msgid "NaiveProxy использует одну учётную запись: доступна только смена порта."
msgstr "NaiveProxy 使用一个共享账户：仅支持修改端口。"

msgid "NaiveProxy использует одну учётную запись: доступна только смена порта. Caddyfile проверяется перед перезапуском."
msgstr "NaiveProxy 使用一个共享账户：仅支持修改端口。重启前会验证 Caddyfile。"

