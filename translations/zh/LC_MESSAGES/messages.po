#: dist/VPNServerManager-Clean.app/Contents/Resources/templates/monitoring.html:276
#: templates/help.html:357 templates/monitoring.html:276
msgid "Внимание:"
msgstr "注意："

#: dist/VPNServerManager-Clean.app/Contents/Resources/templates/help.html:357
