# Git attributes for VPN Server Manager
# Ensures correct line endings across platforms

# Auto detect text files and normalize to LF
* text=auto

# Windows batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts should use LF
*.sh text eol=lf

# Python files should use LF
*.py text eol=lf

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
.env* text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.enc binary
*.dmg binary
*.exe binary
*.app binary
*.pkg binary
*.pyc binary
*.pyd binary
*.so binary
*.dll binary
*.dylib binary


# Translations
*.po text eol=lf
*.pot text eol=lf
*.mo binary

# Windows-only tooling (keep CRLF so Windows tools don't choke)
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.iss text eol=crlf

# Templates / examples / Cursor rules
*.template text eol=lf
*.example text eol=lf
*.mdc text eol=lf

# Files without extensions
Dockerfile text eol=lf
Makefile text eol=lf
LICENSE text eol=lf

# Dotfiles
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf
.editorconfig text eol=lf

# Databases and archives
*.db binary
*.sqlite binary
*.sqlite3 binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.7z binary

# Backups kept in-tree
*.old text eol=lf
*.bak text eol=lf
